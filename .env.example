# Copy to .env and edit. Never commit the real .env.

# Random value shared by both apps: openssl rand -hex 32
SESSION_SECRET=

# Image source (defaults shown). Pin a tag such as a git SHA for repeatable deploys.
#IMAGE_REGISTRY=ghcr.io/wvanbesien
#IMAGE_TAG=latest

# ---- OIDC app ----
# Public URL users reach the app on: https, no port for 443, no trailing slash.
OIDC_BASE_URL=https://oidc-demo.example.com
OIDC_ISSUER=https://<tenant>.id.cyberark.cloud/<app-id>/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
#OIDC_SCOPE=openid profile email offline_access
#OIDC_CLIENT_AUTH=post        # post | basic | none

# ---- SAML app ----
SAML_BASE_URL=https://saml-demo.example.com
SAML_IDP_METADATA_URL=https://<tenant>.id.cyberark.cloud/saml/metadata/<app-id>
#SAML_NAMEID_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress

# ---- Only for the bundled Caddy proxy (--profile caddy): hostnames without https:// ----
OIDC_HOSTNAME=oidc-demo.example.com
SAML_HOSTNAME=saml-demo.example.com

# Host ports used when NOT using Caddy (your own proxy forwards to these)
#OIDC_HOST_PORT=8080
#SAML_HOST_PORT=8081
